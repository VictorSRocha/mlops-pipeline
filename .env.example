# =============================================================================
# .env.example — template de variáveis de ambiente
# =============================================================================
# INSTRUÇÕES:
#   1. Copie este arquivo: cp .env.example .env
#   2. Preencha os valores reais no arquivo .env
#   3. NUNCA commite o .env — ele já está no .gitignore
#
# Este arquivo (.env.example) É commitado: serve como documentação
# para qualquer pessoa que clonar o repositório saber o que configurar.
# =============================================================================

# --- API de clientes ----------------------------------------------------------
# URL base da API REST. Não inclua a barra final.
API_BASE_URL=https://api.empresa.com/v1

# Token de autenticação (Bearer token).
# Solicite ao time de backend ou gere no painel da API.
API_TOKEN=seu_token_aqui

# --- Banco de dados -----------------------------------------------------------
# String de conexão no formato padrão SQLAlchemy.
#
# SQLite (local, sem instalar nada — ideal para desenvolvimento):
#   DATABASE_URL=sqlite:///data/local.db
#
# PostgreSQL (produção):
#   DATABASE_URL=postgresql://usuario:senha@localhost:5432/mlops_db
#
# MySQL:
#   DATABASE_URL=mysql+pymysql://usuario:senha@localhost:3306/mlops_db
DATABASE_URL=sqlite:///data/local.db

# --- Armazenamento de arquivos (opcional) ------------------------------------
# Deixe em branco para usar apenas arquivos locais.
# Necessário somente se as fontes FileSource usarem URIs s3:// ou gs://

# AWS S3
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=
S3_BUCKET=

# Google Cloud Storage
GOOGLE_APPLICATION_CREDENTIALS=
GCS_BUCKET=

# --- Configurações gerais da pipeline ----------------------------------------
# Nível de log: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO

# Tamanho de cada página na coleta via API (número de registros por requisição)
API_PAGE_SIZE=500

# Tamanho do chunk na leitura do banco (número de linhas por vez na memória)
DB_CHUNK_SIZE=10000
